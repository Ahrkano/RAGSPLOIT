# Configuracoes Gerais
LAB_LLM_URL=http://192.168.70.40:8080
NVD_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- SELETOR DE INTELIGENCIA ---
# Provedores cloud: 'google' | 'openai' | 'anthropic'. Use 'local' para o tunel SSH.
# No modo cloud, o provedor efetivo tambem e deduzido pelo prefixo do modelo
# em config/ai_settings.json (gemini/..., openai/..., anthropic/...).
AI_PROVIDER=google
#AI_PROVIDER=openai
#AI_PROVIDER=anthropic
#AI_PROVIDER=local

# --- CREDENCIAIS GOOGLE ---
GOOGLE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- CREDENCIAIS OPENAI ---
OPENAI_API_KEY=

# --- CREDENCIAIS ANTHROPIC ---
ANTHROPIC_API_KEY=

# --- CREDENCIAIS LOCAL (SSH) ---
# Use 'gemini/gemini-pro' para Gemini ou '<IP>' para o tunel SSH
LLM_TARGET=gemini/gemini-pro

SSH_HOST=XXX.XXX.XXX.XXX
SSH_PORT=XXXX
SSH_USER=usuario
SSH_PASS=senha

# --- METASPLOIT RPC ---
MSF_RPC_PASSWORD=msfpass

# Web UI (acesso pelo navegador; publish restrito a 127.0.0.1)
WEBUI_USER=admin
WEBUI_PASS=ragsploit

# Scheduler de CVEs (atualizacao automatica da base de ameacas)
CVE_AUTO_UPDATE=true
CVE_UPDATE_HOURS=12
CVE_RUN_AT_START=false
